# Helius API Key (get from https://helius.dev)
HELIUS_API_KEY=your_helius_api_key

# Solana Network (devnet | mainnet-beta)
SOLANA_NETWORK=devnet

# Pool wallet private key (base58 encoded) — auto-generated if not set
POOL_WALLET_PRIVATE_KEY=

# Kirat token mint address (set after running: npm run create-mint)
MINT_ADDRESS=

# Server port
PORT=3000

# Webhook URL (your public server URL or ngrok URL)
WEBHOOK_URL=
